# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security & Auth
JWT_SECRET=super_secret_study_search_engine_jwt_access_token_key_32chars
JWT_REFRESH_SECRET=super_secret_study_search_engine_jwt_refresh_token_key_32chars
COOKIE_SECRET=super_secret_cookie_signing_key_32chars_long_study

# Database (MongoDB)
MONGODB_URI=mongodb://admin:adminpassword@localhost:27017/study_search?authSource=admin

# Cache & Queue (Redis)
REDIS_URL=redis://localhost:6379

# Search (Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elasticpassword

# External APIs (Optional / Mock fallback available)
YOUTUBE_API_KEY=
OPENALEX_EMAIL=researcher@example.com
SEMANTIC_SCHOLAR_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=

# Embeddings
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# Frontend
VITE_API_URL=http://localhost:4000
